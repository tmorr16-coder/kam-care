# ── Supabase (Project Settings → API Keys) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # server only; never expose

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://care.kam.church

# ── OneChurch (Settings & Tools → API / Webhooks) ───────────────────────────
ONECHURCH_TENANT=kam                         # kam.onechurchsoftware.com
ONECHURCH_API_KEY=                           # Custom access, never Super User
ONECHURCH_WEBHOOK_TOKEN=                     # openssl rand -hex 32

# ── Vercel Cron ─────────────────────────────────────────────────────────────
CRON_SECRET=                                 # openssl rand -hex 32

# ── Messaging (optional until you're ready to send) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
RESEND_API_KEY=
EMAIL_FROM=KAM Care <care@kam.church>
